{
  "name": "bruinguessr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "campus:build": "tsx scripts/build-campus.ts",
    "campus:probe": "tsx --env-file=.env.local scripts/probe-coverage.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "photos:mapillary": "tsx --env-file=.env.local scripts/pipeline/mapillary.ts",
    "photos:wikimedia": "tsx --env-file=.env.local scripts/pipeline/wikimedia.ts",
    "photos:import": "tsx scripts/pipeline/import-photos.ts",
    "photos:sheets": "tsx scripts/pipeline/sheets.ts",
    "photos:decide": "tsx scripts/pipeline/decide.ts",
    "photos:publish": "tsx --env-file=.env.local scripts/pipeline/publish.ts",
    "photos:report": "tsx --env-file=.env.local scripts/pipeline/report.ts",
    "test:live": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.live.config.mts",
    "photos:reports": "tsx --env-file=.env.local scripts/pipeline/reports.ts",
    "usernames": "tsx --env-file=.env.local scripts/admin/usernames.ts",
    "photos:rotate": "tsx --env-file=.env.local scripts/pipeline/rotate-filenames.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.6",
    "obscenity": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "exifr": "^7.1.3",
    "osmtogeojson": "^3.0.0-beta.5",
    "pbf": "^5.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
